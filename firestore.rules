rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── PRODUCTS ─────────────────────────────────────────────────────────
    // Public: read all products (website store)
    // Write: authenticated admin only
    match /products/{docId} {
      allow read:   if true;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll(['title', 'price', 'category'])
                    && request.resource.data.price is number
                    && request.resource.data.price >= 0;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // ── CATEGORIES ───────────────────────────────────────────────────────
    match /categories/{docId} {
      allow read:   if true;
      allow write:  if request.auth != null;
    }

    // ── SETTINGS ─────────────────────────────────────────────────────────
    match /settings/{docId} {
      allow read:   if true;
      allow write:  if request.auth != null;
    }

    // ── ORDERS ───────────────────────────────────────────────────────────
    // Public (shop customers) may create an order only with status 'pending'.
    // The authenticated admin may create with ANY status (e.g. offline orders),
    // and is the only one who can read, update or delete.
    match /orders/{docId} {
      allow create: if request.auth != null
                    || (request.resource.data.keys().hasAll(['ref', 'items', 'status'])
                        && request.resource.data.status == 'pending');
      allow read, update, delete: if request.auth != null;
    }

    // ── STATS (visit counter) ────────────────────────────────────────────
    // Public may read the total and increment it. Keeps it simple & free.
    match /stats/{docId} {
      allow read:  if true;
      allow write: if true;
    }

    // ── DENY EVERYTHING ELSE ─────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
